# requires-user-capability: false

# Create a repository with a file so it has a default branch
fixture-repo shared REPO
env ISSUE_PREFIX=${SCRIPT_NAME}-${RANDOM_STRING}

# Clone the repo
exec gh repo clone $ORG/$REPO

cd $REPO

# Create one Bug-typed issue and one untyped issue
exec gh issue create --title $ISSUE_PREFIX-typed-bug --body '' --type 'Bug'
exec gh issue create --title $ISSUE_PREFIX-untyped --body ''

sleep 3

# Filtering by type returns only the typed issue
exec gh issue list --type 'Bug' --limit 1000 --json title --jq='.[].title'
stdout $ISSUE_PREFIX'-typed-bug'
! stdout $ISSUE_PREFIX'-untyped'
