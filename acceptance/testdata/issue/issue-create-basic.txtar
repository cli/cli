
# Create a repository with a file so it has a default branch
fixture-repo shared REPO
env ISSUE_TITLE=${SCRIPT_NAME}-${RANDOM_STRING}

# Target the fixture repository
env GH_REPO=$ORG/$REPO

# Create an issue in the repo
exec gh issue create --title $ISSUE_TITLE --body 'Feature Body'
stdout2env ISSUE_URL

# Check the issue was created
exec gh issue view $ISSUE_URL
stdout 'title:\t'$ISSUE_TITLE'$'
