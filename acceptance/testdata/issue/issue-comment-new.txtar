# requires-user-capability: false

# Setup environment variables used for testscript

# Create a repository with a file so it has a default branch
fixture-repo shared REPO
env ISSUE_TITLE=${SCRIPT_NAME}-${RANDOM_STRING}

# Clone the repo
exec gh repo clone ${ORG}/${REPO}

# Create an issue in the repo
cd ${REPO}
exec gh issue create --title $ISSUE_TITLE --body 'Feature Body'
stdout2env ISSUE_URL

# Comment on the issue
exec gh issue comment ${ISSUE_URL} --body 'Looks like a great feature!'

# View the issue
exec gh issue view ${ISSUE_URL} --comments
stdout 'Looks like a great feature!'
