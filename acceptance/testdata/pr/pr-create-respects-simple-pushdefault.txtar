
# Setup environment variables used for testscript

# Use gh as a credential helper
exec gh auth setup-git

# Create a repository with a file so it has a default branch
fixture-repo shared REPO
env BRANCH_NAME=${SCRIPT_NAME}-${RANDOM_STRING}
env PR_TITLE=${SCRIPT_NAME}-${RANDOM_STRING}

exec gh repo view ${ORG}/${REPO} --json id --jq '.id'
stdout2env REPO_ID

# Clone the repo
exec gh repo clone ${ORG}/${REPO}
cd ${REPO}

# Configure default push behavior so local and remote branches have to be the same
exec git config push.default simple

# Prepare a branch where changes are pulled from the default branch instead of remote branch of same name
exec git checkout -b $BRANCH_NAME
exec git branch --set-upstream-to origin/main
exec git commit --allow-empty -m 'Empty Commit'
exec git push origin $BRANCH_NAME

# Create the PR
exec gh pr create --title $PR_TITLE --body 'Feature Body'
stdout2env PR_URL

# Assert that the PR was created with the correct head repository and refs
exec gh pr view $PR_URL --json headRefName,headRepository,baseRefName,isCrossRepository
stdout {"baseRefName":"main","headRefName":"$BRANCH_NAME","headRepository":{"id":"${REPO_ID}","name":"${REPO}","nameWithOwner":"${ORG}/${REPO}"},"isCrossRepository":false}
