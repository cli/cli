# requires-user-capability: false

# Setup environment variables used for testscript

# Use gh as a credential helper
exec gh auth setup-git

# Create a repository with a file so it has a default branch
fixture-repo shared REPO
env BRANCH_NAME=branch-${RANDOM_STRING}
env PR_TITLE=PR-${RANDOM_STRING}

# Clone the repo
exec gh repo clone ${ORG}/${REPO}
cd ${REPO}

# Configure default push behavior so local and remote branches will be the same
exec git config push.default current

# Prepare a branch where changes are pulled from the default branch instead of remote branch of same name
exec git checkout -b $BRANCH_NAME
exec git branch --set-upstream-to origin/main
exec git rev-parse --abbrev-ref $BRANCH_NAME@{upstream}
stdout origin/main

# Create the PR
exec git commit --allow-empty -m 'Empty Commit'
exec git push
exec gh pr create -B main -H $BRANCH_NAME --title $PR_TITLE --body 'Feature Body'

# View the PR
exec gh pr view
stdout $PR_TITLE

# Check the PR status
exec gh pr status
stdout $PR_TITLE
stdout $BRANCH_NAME
