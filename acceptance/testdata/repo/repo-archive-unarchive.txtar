
# Create a repository with a file so it has a default branch
fixture-repo isolated REPO

# Check that the repo exists and isn't archived
exec gh repo view $ORG/$REPO --json=isArchived --jq='.isArchived'
stdout 'false'

# Archive the repo
exec gh repo archive $ORG/$REPO --yes

# Check that the repo is archived
exec gh repo view $ORG/$REPO --json=isArchived --jq='.isArchived'
stdout 'true'

# Unarchive the repo
exec gh repo unarchive $ORG/$REPO --yes

# Check that the repo is unarchived
exec gh repo view $ORG/$REPO --json=isArchived --jq='.isArchived'
stdout 'false'
