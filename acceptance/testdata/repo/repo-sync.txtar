
# Use gh as a credential helper
exec gh auth setup-git

# Create and clone a repository with a file so it has a default branch
fixture-repo isolated REPO
exec gh repo clone $ORG/$REPO

# Advance the default branch on the remote, then rewind the local branch so a sync is required
cd $REPO
mv ../asset.txt asset.txt
exec git add .
exec git commit -m 'Add asset.txt'
exec git push
exec git reset --hard HEAD~1
! exists asset.txt

# Syncing the default branch while it is checked out fast-forwards it to match the remote
exec gh repo sync
exists asset.txt
exec git status --porcelain
! stdout .

# Advance the default branch on the remote again, then rewind it and check out a different branch
mv ../asset2.txt asset2.txt
exec git add .
exec git commit -m 'Add asset2.txt'
exec git push
exec git reset --hard HEAD~1
! exists asset2.txt
exec git switch --create topic

# Syncing updates the default branch even though a different branch is checked out
exec gh repo sync
exec git branch --show-current
stdout '^topic$'

# The current worktree is left clean, with no phantom staged changes
exec git status --porcelain
! stdout .

# Checking out the default branch shows it now matches the remote
exec git switch main
exists asset2.txt

-- asset.txt --
Hello, world!
-- asset2.txt --
Hello again, world!
