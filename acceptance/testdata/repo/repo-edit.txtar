
# Create a repository with a file so it has a default branch
fixture-repo isolated REPO

# Check that the repo description is empty
exec gh repo view $ORG/$REPO --json description --jq '.description'
! stdout '.'

# Edit the repo description
exec gh repo edit $ORG/$REPO --description 'newDescription'

# Check that the repo description is updated
exec gh repo view $ORG/$REPO --json description --jq '.description'
stdout 'newDescription'
