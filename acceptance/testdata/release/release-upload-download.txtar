# requires-user-capability: false

# Create a repository with a file so it has a default branch
fixture-repo shared REPO
env TAG=v${SCRIPT_NAME}-${RANDOM_STRING}

# Clone the repo
exec gh repo clone $ORG/$REPO

# Create a release in the repo
cd $REPO
exec gh release create $TAG --notes 'awesome release'

# Upload an asset to the release
exec gh release upload $TAG ../asset.txt

# Download the asset from the release
exec gh release download $TAG
exists asset.txt

# Download the asset in archive form
exec gh release download $TAG --archive=zip --output source.zip
exists source.zip

-- asset.txt --
Hello, world!
