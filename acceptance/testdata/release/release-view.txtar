# requires-user-capability: false

# Create a repository with a file so it has a default branch
fixture-repo shared REPO
env TAG=v${SCRIPT_NAME}-${RANDOM_STRING}

# Clone the repo
exec gh repo clone $ORG/$REPO

# Create a release in the repo
cd $REPO
exec gh release create $TAG --notes 'awesome release'

# View the release
exec gh release view $TAG
stdout $TAG