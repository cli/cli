
# Create a repository with a file so it has a default branch
fixture-repo shared REPO
env TAG=v${SCRIPT_NAME}-${RANDOM_STRING}

# Create a release in the repo
exec gh release create $TAG --repo $ORG/$REPO --notes 'awesome release'

# Upload an asset to the release
exec gh release upload $TAG --repo $ORG/$REPO asset.txt

# Delete the asset from the release
exec gh release delete-asset $TAG asset.txt --repo $ORG/$REPO --yes

# Verify the release has no assets
exec gh release view $TAG --repo $ORG/$REPO --json assets --jq '.assets | length'
stdout '0'

# Downloading the deleted asset should fail
! exec gh release download $TAG --repo $ORG/$REPO
stderr 'no assets to download'

# Delete the release and its tag
exec gh release delete $TAG --repo $ORG/$REPO --yes --cleanup-tag

# Wait for tag deletion to become visible through the ref lookup
sleep 5

# Verify the release is gone
! exec gh release view $TAG --repo $ORG/$REPO
stderr 'release not found'

# Verify the tag is gone
! exec gh api repos/$ORG/$REPO/git/ref/tags/$TAG
stderr 'Not Found'

-- asset.txt --
Hello, world!
