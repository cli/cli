
# Setup useful env vars

# Create a repository
fixture-repo shared REPO
env LABEL_NAME=acceptance-test-${RANDOM_STRING}

# Set the GH_REPO env var to reduce redundant flags
env GH_REPO=${ORG}/${REPO}

# Create a custom label
exec gh label create $LABEL_NAME --description 'First Description'

# List the labels and check our custom label is there
exec gh label list --limit 1000
stdout $LABEL_NAME'\tFirst Description'

# Edit the label
exec gh label edit $LABEL_NAME --description 'Edited Description'

# List the labels and check our custom label has been updated
exec gh label list --limit 1000
stdout $LABEL_NAME'\tEdited Description'
