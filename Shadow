    except Exception:
        await _delete_token(msg_id)
        return HTMLResponse(content="<h3>Message missing.</h3>", status_code=500)
    try:
        os.remove(file_path)
    except Exception:
        pass
    await _delete_token(msg_id)
    b64 = base64.b64encode(data).decode()
    html = f\"\"\"<!doctype html>
