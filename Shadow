import os
import base64
import uuid
import time
from fastapi import FastAPI, HTTPException
from fastapi.responses import HTMLResponse
from pydantic import BaseModel

REDIS_URL = os.environ.get("REDIS_URL")
BLOB_DIR = os.environ.get("BLOB_DIR", "./blobs")
FRONTEND_ORIGIN = os.environ.get("FRONTEND_ORIGIN", "*")

os.makedirs(BLOB_DIR, exist_ok=True)

app = FastAPI(title="OneTimeView-Internet")

redis = None
if REDIS_URL:
    try:
        import redis.asyncio as aioredis
        redis = aioredis.from_url(REDIS_URL, decode_responses=True)
    except Exception as e:
        print("Failed to init redis:", e)
        redis = None

_inmem_tokens = {}
_inmem_claimed = set()

class SendRequest(BaseModel):
    content_b64: str
    ttl_seconds: int = 3600

class SendResponse(BaseModel):
    msg_id: str
    one_time_token: str
    expires_at: int

class ClaimRequest(BaseModel):
    msg_id: str
    one_time_token: str

async def _set_token(msg_id, token, ttl):
    if redis:
        await redis.set(f"token:{msg_id}", token, ex=ttl)
        await redis.delete(f"claimed:{msg_id}")
    else:
        _inmem_tokens[msg_id] = (token, int(time.time()) + ttl)
        _inmem_claimed.discard(msg_id)

async def _get_token(msg_id):
    if redis:
        return await redis.get(f"token:{msg_id}")
    else:
        v = _inmem_tokens.get(msg_id)
        if not v:
            return None
        token, exp = v
        if int(time.time()) > exp:
            _inmem_tokens.pop(msg_id, None)
            return None
        return token

async def _set_claimed(msg_id):
    if redis:
        return await redis.setnx(f"claimed:{msg_id}", "1")
    else:
        if msg_id in _inmem_claimed:
            return False
        _inmem_claimed.add(msg_id)
        return True

async def _delete_token(msg_id):
    if redis:
        await redis.delete(f"token:{msg_id}")
    else:
        _inmem_tokens.pop(msg_id, None)

@app.post("/v1/messages", response_model=SendResponse)
async def send_message(payload: SendRequest):
    try:
        data = base64.b64decode(payload.content_b64)
    except Exception:
        raise HTTPException(status_code=400, detail="Invalid base64")
    msg_id = str(uuid.uuid4())
    token = str(uuid.uuid4())
    ttl = int(payload.ttl_seconds)
    file_path = os.path.join(BLOB_DIR, f"{msg_id}.blob")
    with open(file_path, "wb") as f:
        f.write(data)
    await _set_token(msg_id, token, ttl)
    expires_at = int(time.time()) + ttl
    return SendResponse(msg_id=msg_id, one_time_token=token, expires_at=expires_at)

@app.post("/v1/messages/claim")
async def claim_message(payload: ClaimRequest):
    msg_id = payload.msg_id
    provided = payload.one_time_token
    stored = await _get_token(msg_id)
    if stored is None:
        raise HTTPException(status_code=410, detail="No such message or expired")
    if stored != provided:
        raise HTTPException(status_code=403, detail="Invalid token")
    ok = await _set_claimed(msg_id)
    if not ok:
        raise HTTPException(status_code=410, detail="Already claimed")
    file_path = os.path.join(BLOB_DIR, f"{msg_id}.blob")
    try:
        with open(file_path, "rb") as f:
            data = f.read()
    except Exception:
        await _delete_token(msg_id)
        raise HTTPException(status_code=500, detail="Blob missing")
    try:
        os.remove(file_path)
    except Exception:
        pass
    await _delete_token(msg_id)
    return base64.b64encode(data).decode()

